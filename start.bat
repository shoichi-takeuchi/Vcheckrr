@echo off
chcp 65001 > nul
cd /d "%~dp0"

echo ============================================================
echo  秀丸メール フィッシング検知システム 起動中...
echo ============================================================
echo.
echo  監視中... (終了するには stop.bat を実行するか Ctrl+C)
echo  ※このウィンドウを最小化したまま起動し続けます
echo.

python main.py

if errorlevel 1 (
    echo.
    echo [エラー] 起動に失敗しました。
    echo 上記のエラーメッセージを確認してください。
    pause
)
